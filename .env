# Environment variables for dev, stage, and prod environments

# Development environment
DEV_COINMARKETCAP_API_KEY=your_dev_api_key
DEV_MONGODB_URI=your_dev_mongodb_uri

# Staging environment
STAGE_COINMARKETCAP_API_KEY=your_stage_api_key
STAGE_MONGODB_URI=your_stage_mongodb_uri

# Production environment
PROD_COINMARKETCAP_API_KEY=your_prod_api_key
PROD_MONGODB_URI=your_prod_mongodb_uri
